// LUNEX TEAM backend — Prisma schema.
// Every model here is provider-agnostic Prisma (no Postgres-only column
// types), so pointing DATABASE_URL at a different Postgres instance never
// needs a schema rewrite — see backend/docs/security-architecture.md §5.
//
// Chapter/ChapterPage/ChapterUnlock (added alongside the image-protection
// pipeline) are real; Series/Team/Comment are still frontend-mock-only —
// see §4/§19 of the same doc before assuming anything content-related here
// is the full picture.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  username     String   @unique
  /// Optional — an account created via Discord/Google OAuth never sets one.
  /// login() must therefore reject (not crash on) a password attempt when
  /// this is null, rather than assuming every user has one.
  passwordHash String?
  displayName  String?
  bio          String?
  /// Small (256x256, re-encoded webp) — stored in the DB rather than local
  /// disk because Railway's local filesystem is wiped on every deploy; a
  /// dedicated object store (S3/R2) is the future upgrade, not needed yet
  /// at avatar-image sizes.
  avatarImage     Bytes?
  avatarMimeType  String?
  role         String   @default("reader")
  isBanned     Boolean  @default(false)
  bannedAt     DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions       Session[]
  devices        Device[]
  loginEvents    LoginEvent[]
  oauthAccounts  OAuthAccount[]
  notifications  Notification[]
  chapterUnlocks ChapterUnlock[]

  @@map("users")
}

/// One row per linked external identity. Deliberately its own table rather
/// than columns on User (discordId/googleId) — a user can link both
/// providers to one account, and adding a third provider later never
/// touches this schema again.
model OAuthAccount {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String // "discord" | "google"
  providerAccountId String
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@map("oauth_accounts")
}

model Device {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fingerprintHash String
  firstSeenAt     DateTime @default(now())
  lastSeenAt      DateTime @updatedAt
  trustScore      Int      @default(0)

  sessions Session[]

  @@unique([userId, fingerprintHash])
  @@map("devices")
}

/// A "session family" is the chain of refresh tokens issued from one login.
/// Reuse of an already-rotated token in the same family revokes the whole
/// family — see AuthService.refresh() for why.
model Session {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId         String
  device           Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  familyId         String
  refreshTokenHash String    @unique
  revoked          Boolean   @default(false)
  createdAt        DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?

  @@index([familyId])
  @@map("sessions")
}

model LoginEvent {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String
  ip        String
  outcome   String // "success" | "invalid_credentials" | "rate_limited"
  riskScore Int      @default(0)
  at        DateTime @default(now())

  @@index([email, at])
  @@map("login_events")
}

/// Append-only by convention at the application layer here; the production
/// Postgres deployment additionally revokes UPDATE/DELETE at the DB role
/// grant level (see §7 / §24 of the architecture doc) — SQLite has no
/// equivalent role system, so that specific control only exists once this
/// is deployed against real Postgres.
model AuditLog {
  id       String   @id @default(uuid())
  actorId  String?
  action   String
  target   String?
  ip       String?
  at       DateTime @default(now())

  @@map("audit_log")
}

/// One row per stored page image. `storageKey` is opaque to everything except
/// StorageService — swapping local disk for S3/R2 later only touches that one
/// class, never this table or the image pipeline around it.
///
/// `width`/`height` are recorded at upload time (not recomputed per request)
/// so ImagesService can pick an adaptive tile grid without re-decoding the
/// full image just to read its dimensions.
model ImageAsset {
  id         String   @id @default(uuid())
  storageKey String   @unique
  checksum   String
  mimeType   String
  width      Int
  height     Int
  createdAt  DateTime @default(now())

  chapterPage ChapterPage?

  @@map("image_assets")
}

/// A published chapter's metadata. `seriesId`/`teamId` reference the
/// frontend's mock Series/Team ids — deliberately NOT a foreign key, the
/// same convention ImageAccessLog.assetId already uses, since Series/Team
/// aren't real tables yet (architecture doc §4/§19). Only chapter+page
/// content moved server-side for the image-protection work; the catalog
/// metadata around it stays mock until that's tackled separately.
model Chapter {
  id           String    @id @default(uuid())
  seriesId     String
  teamId       String
  number       Float
  title        String
  isPublished  Boolean   @default(false)
  scheduledFor DateTime?
  /// true = force-locked, false = force-open, null = automatic (sliding free-chapter window) — mirrors the frontend's isChapterLocked() manual override.
  manualLock   Boolean?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  pages   ChapterPage[]
  unlocks ChapterUnlock[]

  @@unique([seriesId, number])
  @@index([seriesId])
  @@map("chapters")
}

/// pageNumber is an explicit column, not an array index — the admin upload
/// flow and reader both need unambiguous "page 1/2/3..." ordering that
/// survives re-fetching in any order.
model ChapterPage {
  id         String     @id @default(uuid())
  chapterId  String
  chapter    Chapter    @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  pageNumber Int
  assetId    String     @unique
  asset      ImageAsset @relation(fields: [assetId], references: [id])

  @@unique([chapterId, pageNumber])
  @@map("chapter_pages")
}

/// A real, server-verified purchase/unlock — this is what issueToken()
/// actually checks before handing out a page token, replacing the
/// client-only `unlockedChapters` localStorage flag that a user could
/// otherwise just edit to grant themselves access.
model ChapterUnlock {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapterId  String
  chapter    Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  unlockedAt DateTime @default(now())

  @@unique([userId, chapterId])
  @@map("chapter_unlocks")
}

/// Leak-tracing ledger: every issued access token AND every actual byte
/// stream is logged with who requested it. If a page ends up on a piracy
/// site, this table (cross-referenced with the watermark baked into the
/// pixels — see ImagesService.watermark()) is how the leaking session gets
/// identified after the fact, not just blocked in advance.
///
/// `assetId` is deliberately a plain string, NOT a foreign key to
/// ImageAsset: rejected requests (asset_mismatch, a probed/enumerated id
/// that was never real) must still be logged, since that's exactly the
/// signal that flags an enumeration attack — a FK constraint would make
/// logging the attempt fail on the very requests most worth recording.
model ImageAccessLog {
  id                String   @id @default(uuid())
  assetId           String
  userId            String
  deviceFingerprint String
  ip                String
  event             String // "token_issued" | "stream_served" | "token_rejected"
  reason            String?
  at                DateTime @default(now())

  @@index([assetId, at])
  @@index([userId, at])
  @@map("image_access_log")
}

/// Interim StorageService backend, used until a real object store (S3/R2) is
/// configured — see architecture doc §16/§19. Keyed the same opaque way
/// local disk would be (ImageAsset.storageKey); nothing outside
/// PrismaBlobStorageService ever reads this table directly. NOT meant to be
/// the permanent home for chapter-image bytes at scale — swapping to S3/R2
/// later only touches that one class, per the StorageService interface.
model ImageBlob {
  storageKey String   @id
  data       Bytes
  createdAt  DateTime @default(now())

  @@map("image_blobs")
}

/// Real, server-persisted notifications — distinct from the client-only mock
/// "notifications" tab that used to show a hardcoded list. Producers are
/// account-security events that already happen server-side today (password
/// change, a login from a device never seen before, an admin changing a
/// user's role); there's no Series/Chapter/Comment table yet (those still
/// live in the frontend's mock dataset), so content-driven notifications
/// ("new chapter from a series you follow") aren't wired up until that
/// content moves server-side too.
model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
  @@map("notifications")
}
