# Local/dev — SQLite, zero external infra required.
# Production: postgresql://user:pass@host:5432/lunex?schema=public (see prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# Generate real secrets for anything beyond local dev:
#   openssl rand -base64 48
JWT_ACCESS_SECRET="dev-only-access-secret-change-me"
JWT_REFRESH_PEPPER="dev-only-refresh-pepper-change-me"

PORT=4000
NODE_ENV=development
