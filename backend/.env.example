# schema.prisma declares `provider = "postgresql"`, so this MUST be a real
# Postgres connection string — a `file:./dev.db` SQLite URL (an earlier value
# here) fails on boot with Prisma error P1012 (provider mismatch), not just
# a warning. For local dev, point this at any local or free-tier cloud
# Postgres instance; migrations then apply the same way as in production.
DATABASE_URL="postgresql://user:pass@localhost:5432/lunex?schema=public"

# Generate real secrets for anything beyond local dev:
#   openssl rand -base64 48
JWT_ACCESS_SECRET="dev-only-access-secret-change-me"
JWT_REFRESH_PEPPER="dev-only-refresh-pepper-change-me"
IMAGE_TOKEN_SECRET="dev-only-image-token-secret-change-me"

# Shared secret for the Discord bot's machine-to-machine chapter push
# (ServiceKeyGuard, /v1/integrations/bot/*) — must exactly match the bot's
# own BOT_INTEGRATION_SECRET. Not a user credential, just a generated key.
BOT_INTEGRATION_SECRET="dev-only-bot-integration-secret-change-me"

# Secret shared with the frontend (the same value in its BFF_SHARED_KEY). With it, the frontend tells the backend who the
# visitor is, so rate limits and logs are per visitor instead of one shared budget for everyone. Unset = the old behaviour.
#   openssl rand -base64 48
# BFF_SHARED_KEY="change-me"

# Chapter lock and wallet (all optional; these are the launch defaults):
#   LOCKED_CHAPTER_COUNT=3     the newest N chapters of each series are locked (0 turns the lock off)
#   FREE_FIRST_CHAPTERS=3      a series' first N chapters are always free
#   CHAPTERS_PER_CREDIT=10     finished chapters that earn one free unlock
#   CHAPTER_COIN_PRICE=50      coins to open one locked chapter

# IMAGE_STORAGE_BACKEND selects the StorageService implementation:
#   unset/anything else -> PrismaBlobStorageService (Postgres image_blobs table, today's default)
#   "local"             -> LocalDiskStorageService (this IMAGE_STORAGE_DIR, dev-only)
#   "r2"                -> R2StorageService (Cloudflare R2 below, the real production target)
# IMAGE_STORAGE_BACKEND="local"
IMAGE_STORAGE_DIR="./storage/images"

# Cloudflare R2 — only needed once IMAGE_STORAGE_BACKEND=r2. Never set these
# locally; local dev keeps using IMAGE_STORAGE_BACKEND=local.
# R2_ACCOUNT_ID="your-cloudflare-account-id"
# R2_BUCKET_NAME="lunex-chapter-images"
# R2_ACCESS_KEY_ID="change-me"
# R2_SECRET_ACCESS_KEY="change-me"

# How long IP-bearing logs are kept before RetentionService deletes them (a
# daily sweep). These defaults are the periods the privacy policy states, so
# change the policy page in the same commit if you change them. Values under
# 7 are ignored (a typo must never mean "delete everything").
# RETENTION_LOGIN_EVENTS_DAYS=90
# RETENTION_IMAGE_ACCESS_DAYS=180
# RETENTION_AUDIT_DAYS=365
# RETENTION_REMOVED_COMMENTS_DAYS=90

# Must exactly match the origin the frontend actually runs on — OAuthController
# derives every provider redirect_uri from this, and it has to be byte-identical
# to what's registered in the Discord/Google developer consoles.
FRONTEND_URL="http://localhost:3000"

# From https://discord.com/developers/applications (OAuth2 tab — not the Bot tab)
DISCORD_CLIENT_ID="change-me"
DISCORD_CLIENT_SECRET="change-me"

# From https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="change-me"
GOOGLE_CLIENT_SECRET="change-me"

PORT=4000
NODE_ENV=development

# Where the one-off catalogue import reads the old site from (see architecture doc §27).
# LEGACY_SITE_ORIGIN="https://lunexteam.com"
# How long one slice of the owner's server-side chapter import works before reporting progress.
#  Default 90000.
# LEGACY_CHAPTER_BUDGET_MS="90000"

# Chapter import from Google Drive (optional). A Google service account's key file, pasted as one line of JSON (or base64 of it).
# Folders that are public ("anyone with the link") work as they are; a private folder has to be shared with the account's
# client_email (shown to the person uploading). For local development you can point at the key file instead:
# GOOGLE_DRIVE_CREDENTIALS_JSON=
# GOOGLE_DRIVE_CREDENTIALS_FILE=/path/to/service-account.json
