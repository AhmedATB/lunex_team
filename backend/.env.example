# Local/dev — SQLite, zero external infra required.
# Production: postgresql://user:pass@host:5432/lunex?schema=public (see prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# Generate real secrets for anything beyond local dev:
#   openssl rand -base64 48
JWT_ACCESS_SECRET="dev-only-access-secret-change-me"
JWT_REFRESH_PEPPER="dev-only-refresh-pepper-change-me"
IMAGE_TOKEN_SECRET="dev-only-image-token-secret-change-me"

# Local/dev — plain filesystem under backend/storage/. Production points this
# at S3/R2 credentials instead (see StorageService for the swap point).
IMAGE_STORAGE_DIR="./storage/images"

PORT=4000
NODE_ENV=development
